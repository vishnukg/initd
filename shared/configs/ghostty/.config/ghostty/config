# --- Core Settings ---
# Bytes, not lines (10MB = the default; allocated lazily, ~tens of
# thousands of lines). The old value of 10000 was only ~10KB.
scrollback-limit = 10000000
window-padding-x = 0
window-padding-y = 0
confirm-close-surface = false
shell-integration = fish
shell-integration-features = no-cursor

bell-features = no-system,no-audio,no-attention,no-title,no-border
cursor-style = block
cursor-style-blink = false
cursor-color = #ffffff
cursor-text = #141414

macos-titlebar-style = transparent
# Make Option behave as terminal Alt on every keyboard layout so Neovim's
# Alt-arrow resize mappings and other Meta bindings match Linux.
macos-option-as-alt = true
# Disable GTK titlebar on Linux (macOS uses its own titlebar system)
gtk-titlebar = false
window-colorspace = display-p3
resize-overlay = never

# --- Background & Opacity ---
background = #000000
background-opacity = 0.58
background-blur = false

# --- Fonts ---
# FiraCode Nerd Font, Retina weight (450, between Regular and Medium) — kept
# in step with kitty.conf. The patched build works fine as Ghostty's text font
# on both platforms (unlike kitty's CoreText backend, which rejects it) and
# brings its own icon glyphs at natural width. There is no plain "Fira Code"
# on Linux, and naming it that silently fell back to Noto Sans Mono; Fira Code
# has no italic face, so italic reuses the upright style. Verify the resolved
# face with `ghostty +show-face --string=Ag` — a missing family falls back
# silently.
font-family = "FiraCode Nerd Font"
font-style = Retina
font-style-italic = Retina
font-size = 16
font-feature = -calt
font-feature = -liga
font-thicken = false

# --- Theme: VSCode Dark ---
foreground = #cccccc
selection-foreground = #cccccc
selection-background = #264f78

palette = 0=#000000
palette = 1=#f14c4c
palette = 2=#23d18b
palette = 3=#f5f543
palette = 4=#3b8eea
palette = 5=#d670d6
palette = 6=#29b8db
palette = 7=#e5e5e5
palette = 8=#666666
palette = 9=#cd3131
palette = 10=#0dbc79
palette = 11=#e5e510
palette = 12=#2472c8
palette = 13=#bc3fbc
palette = 14=#11a8cd
palette = 15=#e5e5e5

# --- Windows ---
# No split or tab bindings by design. tmux owns that layer — C-a b/v to split,
# C-a h/j/k/l to move, C-a e to resize, C-a z to zoom, C-a c and Tab for windows
# — and tmux panes survive the terminal dying, which terminal-native splits do
# not. Kept in sync with shared/configs/kitty/kitty.conf.
window-inherit-working-directory = true

# --- Keyboard Shortcuts ---
# Only what tmux cannot do. Note SUPER is claimed by Hyprland on Linux, so these
# fire on macOS (super = Cmd) and are inert on Linux.

# Opacity preset
keybind = super+shift+o=toggle_background_opacity

# New window — the compositor's and macOS's job, not tmux's.
keybind = super+enter=new_window
keybind = ctrl+enter=unbind

# Closing a window is deliberate-only; tmux holds the session either way.
keybind = super+w=ignore

# Home/End escape sequences, not ^A/^E: ^A is the tmux prefix, which would
# swallow the keypress instead of moving the cursor.
keybind = super+arrow_left=text:\x1b[H
keybind = super+arrow_right=text:\x1b[F
