# --- Core Settings ---
# Bytes, not lines (10MB; allocated lazily, ~tens of thousands of lines). The
# old value of 10000 was only ~10KB. 1.4 renamed this from scrollback-limit and
# raised the default to 50MB; 10MB stays because every dev box window runs the
# box's tmux, which keeps its own history, so Ghostty's barely fills.
scrollback-limit-bytes = 10000000
window-padding-x = 0
window-padding-y = 0
confirm-close-surface = false
shell-integration = fish
shell-integration-features = no-cursor

bell-features = no-system,no-audio,no-attention,no-title,no-border
cursor-style = block
cursor-style-blink = false
cursor-color = #ffffff
cursor-text = #141414
# Cursor trail on jumps, matching kitty's cursor_trail. The path is relative to
# this file. The default custom-shader-animation = true runs a render loop
# only while the window is focused, which the trail needs to animate.
custom-shader = shaders/cursor-trail.glsl

macos-titlebar-style = transparent
# Just the ghost as the title. A fixed title also makes Ghostty ignore the ones
# programs set (tmux's "#S · #W", nvim). An emoji, not a Nerd Font glyph: the
# titlebar draws in the system font, which has no Private Use Area icons.
title = "👻"
# Make Option behave as terminal Alt on every keyboard layout so Neovim's
# Alt-arrow resize mappings and other Meta bindings match Linux.
macos-option-as-alt = true
# Disable GTK titlebar on Linux (macOS uses its own titlebar system)
gtk-titlebar = false
# Linux: one process per window. A single-instance Ghostty never hands back
# what a closed window used - still true on 1.4 (~3.5 MB per window, 260 MB held
# with none open) - while a process of its own frees everything on exit. The
# default `detect` would go single-instance for launches without a tty (the
# Hyprland keybind, scripts). This setting cannot beat the packaged desktop
# entry's `--gtk-single-instance=true` flag or its D-Bus activation, so
# linux/scripts/ghostty-launcher.mjs shadows that entry for rofi launches.
gtk-single-instance = false
window-colorspace = display-p3
resize-overlay = never

# --- Background & Opacity ---
background = #000000
background-opacity = 0.58
background-blur = false

# --- Fonts ---
# The same face, size and ligatures as kitty (Berkeley Mono 16, see kitty.conf's
# font block for the licensing, sync and fontconfig details). Ghostty is the dev
# box terminal and kitty the local one; they differ in what they connect to, not
# in how text looks. A machine without the private font falls back to the
# platform default - run shared/lib/fonts.sh after `gh auth login`.
#
# Ghostty lists ONE "Berkeley Mono" family with every weight as a style,
# obliques included (`ghostty +list-fonts`), so plain style names reach all four
# faces on macOS - unlike kitty, which needs postscript_name= because CoreText
# hands it the obliques as a separate family. On Linux, fontconfig merges the
# names the same way; linux/configs/fontconfig/fonts.conf's spacing=100 rule
# applies to Ghostty's lookups as much as kitty's. `+show-face` prints only the
# typographic family, identical for every face, so it cannot confirm the
# oblique was picked - check by eye: printf '\e[3mitalic \e[1mbold italic\e[0m'.
font-family = "Berkeley Mono"
font-style = Regular
font-style-bold = Bold
font-style-italic = Oblique
font-style-bold-italic = Bold Oblique
font-size = 16
# macOS stem darkening, Ghostty's equivalent of kitty's text_composition_strategy
# platform (macos.conf). Off, the same face drew visibly thinner than kitty's.
# A no-op on Linux.
font-thicken = true
# kitty rounds its cell UP to whole pixels; Ghostty rounds to nearest. Same 16pt
# glyphs, but measured through tmux's client_cell_* on a Retina Mac kitty's cell
# was 20x39 px and Ghostty's 19x38 - tighter tracking and line spacing that
# reads as smaller text. One pixel each way puts Ghostty on kitty's grid.
adjust-cell-width = 1
adjust-cell-height = 1
# Berkeley carries no Nerd Font icons. Send the Private Use Area to Symbols Nerd
# Font, as kitty's symbol_map does, rather than leaving it to fallback discovery
# (which finds the same font today - this pins it). Powerline separators
# U+E0B0-U+E0D4 are drawn by Ghostty's internal sprites either way.
font-codepoint-map = U+E000-U+F8FF,U+F0000-U+FFFFD,U+100000-U+10FFFD=Symbols Nerd Font
# Ligatures stay ON, as in kitty: Berkeley's GSUB holds them under calt, which
# Ghostty enables by default, so no font-feature lines are needed.

# --- Theme: VSCode Dark ---
foreground = #cccccc
selection-foreground = #cccccc
selection-background = #264f78

palette = 0=#000000
palette = 1=#f14c4c
palette = 2=#23d18b
palette = 3=#f5f543
palette = 4=#3b8eea
palette = 5=#d670d6
palette = 6=#29b8db
palette = 7=#e5e5e5
palette = 8=#666666
palette = 9=#cd3131
palette = 10=#0dbc79
palette = 11=#e5e510
palette = 12=#2472c8
palette = 13=#bc3fbc
palette = 14=#11a8cd
palette = 15=#e5e5e5

# --- Windows ---
# No split or tab bindings by design. tmux owns that layer — C-a b/v to split,
# C-a h/j/k/l to move, C-a e to resize, C-a z to zoom, C-a c and Tab for windows
# — and tmux panes survive the terminal dying, which terminal-native splits do
# not. Kept in sync with shared/configs/kitty/.config/kitty/kitty.conf.
window-inherit-working-directory = true

# --- Keyboard Shortcuts ---
# Only what tmux cannot do. Note SUPER is claimed by Hyprland on Linux, so these
# fire on macOS (super = Cmd) and are inert on Linux.

# Opacity preset
keybind = super+shift+o=toggle_background_opacity

# New window — the compositor's and macOS's job, not tmux's.
keybind = super+enter=new_window
keybind = ctrl+enter=unbind

# Closing a window is deliberate-only; tmux holds the session either way.
keybind = super+w=ignore

# Home/End escape sequences, not ^A/^E: ^A is the tmux prefix, which would
# swallow the keypress instead of moving the cursor.
keybind = super+arrow_left=text:\x1b[H
keybind = super+arrow_right=text:\x1b[F

# --- Linux-only Overrides ---
# `?` marks the include optional, so this is a no-op on macOS, where nothing
# creates the file. On Linux, linux/setup.sh symlinks linux/configs/ghostty/
# linux.conf into place beside this file; it carries background-opacity 0.92.
#
# Ghostty has no equivalent of kitty's `include ${KITTY_OS}.conf` — config-file
# does no variable expansion — so the platform script places the file rather
# than this line selecting it. Most OS-specific settings need none of that:
# macos-* and gtk-* options are silently inert on the wrong platform and live
# above. Only a value that differs per platform has to be split out.
#
# The path is relative to this file, and this must stay LAST because later
# values win. Gitignored — see .gitignore.
config-file = ?linux.conf

# Personal machines: Ghostty is the dev box terminal (ssh dev in a reconnect
# loop, see dev-box.conf). The file is linked there alone; the `?` makes it a
# no-op everywhere else. It sits outside ~/.config/ghostty so the link never
# lands inside this repo dir.
config-file = ?~/.config/ghostty-dev-box.conf
