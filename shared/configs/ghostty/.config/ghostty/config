# --- Core Settings ---
# Bytes, not lines (10MB = the default; allocated lazily, ~tens of
# thousands of lines). The old value of 10000 was only ~10KB.
scrollback-limit = 10000000
window-padding-x = 0
window-padding-y = 0
confirm-close-surface = false
shell-integration = fish
shell-integration-features = no-cursor

bell-features = no-system,no-audio,no-attention,no-title,no-border
cursor-style = block
cursor-style-blink = false
cursor-color = #ffffff
cursor-text = #141414

macos-titlebar-style = transparent
# Make Option behave as terminal Alt on every keyboard layout so Neovim's
# Alt-arrow resize mappings and other Meta bindings match Linux.
macos-option-as-alt = true
# Disable GTK titlebar on Linux (macOS uses its own titlebar system)
gtk-titlebar = false
# One process per window for any launch that does not say otherwise. Ghostty's
# default is `detect`, which coalesces on desktop/D-Bus launches; pinning false
# means a flagless launch — the $mod+Return bind, docker-menu.sh, any script —
# always gets its own process, so its memory comes back when the window closes.
#
# This does NOT reach the launcher path. Fedora's packaged
# com.mitchellh.ghostty.desktop carries `Exec=ghostty --gtk-single-instance=true`
# (and DBusActivatable=true), and an explicit CLI flag beats the config file —
# measured, two launches share one pid with the flag and get separate pids
# without it. So rofi and .desktop launches still join one long-lived server that
# nothing reaps, at ~10 MB per window open/close. Fixing that means shadowing the
# desktop entry in ~/.local/share/applications, which is deliberately not done
# here: it would cost those launches ~270ms -> ~680ms and has to be re-checked
# whenever the package updates.
gtk-single-instance = false
window-colorspace = display-p3
resize-overlay = never

# --- Background & Opacity ---
background = #000000
background-opacity = 0.58
background-blur = false

# --- Fonts ---
# FiraCode Nerd Font — the patched build. Installed by the
# font-fira-code-nerd-font cask on macOS (macos/Brewfile) and, on Linux, by
# linux/setup.sh:install_firacode_nerd_font, which downloads FiraCode.zip from
# the nerd-fonts GitHub release — Fedora packages no Nerd Font build. This is
# DELIBERATELY NOT the same font kitty uses: kitty stays on Berkeley Mono
# (shared/configs/kitty/.config/kitty/kitty.conf), so the two configs no longer
# agree on the font block. That divergence is not drift — kitty's CoreText
# backend silently REJECTS patched Nerd Font builds as text fonts, because
# their double-width icon glyphs fail its monospace validation, and falls back
# to Menlo without warning. Ghostty's font stack has no such restriction, so it
# can use the patched build directly. Do not "resync" these two blocks.
#
# The patched build carries the Nerd Font icon glyphs in-family, so unlike the
# Berkeley setup this needs no Symbols Nerd Font fallback for the starship
# prompt (verified: U+E7C5 resolves to FiraCode Nerd Font). Powerline
# separators U+E0B0-U+E0D4 are drawn by Ghostty's internal sprites either way.
#
# Retina is Fira Code's 450 weight, between Regular (400) and Medium (500) —
# the weight last settled on in fe0e372, kept here. Size is 15, which is what
# the pre-Berkeley config used; kitty is on 16. The two terminals no longer
# match on family, weight OR size, and all three are deliberate.
#
# Fira Code has NO true italic face, so font-style-italic is pinned to the same
# upright style rather than left to default: that is what stops Ghostty
# synthesizing a slant. (The Berkeley era could drop this because Berkeley
# ships a real Oblique.)
#
# UNCONFIRMED, and deliberately recorded as such: whether `font-style = Retina`
# actually resolves. Fira Code's weights are NOT RIBBI-paired —
# FiraCodeNerdFont-Retina.ttf sets name ID 1 to "FiraCode Nerd Font Ret" with
# subfamily "Regular", and only the typographic names (16/17) say "FiraCode
# Nerd Font" / "Retina". CoreText keys off ID1/ID2, so on macOS the "FiraCode
# Nerd Font" family holds only Regular and Bold, and `ghostty +list-fonts`
# reports the styles ABBREVIATED (Reg / Ret / Med / SemBd). So "Retina" may be
# falling back to Regular (400) with no warning. This is the same non-RIBBI
# trap Berkeley Mono's obliques hit in kitty.conf.
#
# It cannot be settled from the CLI. `ghostty +show-face` prints the
# TYPOGRAPHIC family (ID16), which is "FiraCode Nerd Font" for EVERY weight, so
# it confirms the family resolved but never which face. Ghostty has no
# postscript_name escape hatch either: font-family = "FiraCodeNF-Ret" falls
# back exactly like a nonexistent family (measured). Judge it by eye; if the
# text looks too light, try `font-style = Ret`, or move to family "Fira Code"
# (the unpatched build, which +list-fonts does expose with a real "Retina"
# style) and let Symbols Nerd Font supply the icons again.
font-family = "FiraCode Nerd Font"
font-style = Retina
font-style-italic = Retina
font-size = 15
font-feature = -calt
font-feature = -liga
font-thicken = false

# --- Theme: VSCode Dark ---
foreground = #cccccc
selection-foreground = #cccccc
selection-background = #264f78

palette = 0=#000000
palette = 1=#f14c4c
palette = 2=#23d18b
palette = 3=#f5f543
palette = 4=#3b8eea
palette = 5=#d670d6
palette = 6=#29b8db
palette = 7=#e5e5e5
palette = 8=#666666
palette = 9=#cd3131
palette = 10=#0dbc79
palette = 11=#e5e510
palette = 12=#2472c8
palette = 13=#bc3fbc
palette = 14=#11a8cd
palette = 15=#e5e5e5

# --- Windows ---
# No split or tab bindings by design. tmux owns that layer — C-a b/v to split,
# C-a h/j/k/l to move, C-a e to resize, C-a z to zoom, C-a c and Tab for windows
# — and tmux panes survive the terminal dying, which terminal-native splits do
# not. Kept in sync with shared/configs/kitty/.config/kitty/kitty.conf.
window-inherit-working-directory = true

# --- Keyboard Shortcuts ---
# Only what tmux cannot do. Note SUPER is claimed by Hyprland on Linux, so these
# fire on macOS (super = Cmd) and are inert on Linux.

# Opacity preset
keybind = super+shift+o=toggle_background_opacity

# New window — the compositor's and macOS's job, not tmux's.
keybind = super+enter=new_window
keybind = ctrl+enter=unbind

# Closing a window is deliberate-only; tmux holds the session either way.
keybind = super+w=ignore

# Home/End escape sequences, not ^A/^E: ^A is the tmux prefix, which would
# swallow the keypress instead of moving the cursor.
keybind = super+arrow_left=text:\x1b[H
keybind = super+arrow_right=text:\x1b[F

# --- Linux-only Overrides ---
# `?` marks the include optional, so this is a no-op on macOS, where nothing
# creates the file. On Linux, linux/setup.sh symlinks linux/configs/ghostty/
# linux.conf into place beside this file; it carries background-opacity 0.92.
#
# Ghostty has no equivalent of kitty's `include ${KITTY_OS}.conf` — config-file
# does no variable expansion — so the platform script places the file rather
# than this line selecting it. Most OS-specific settings need none of that:
# macos-* and gtk-* options are silently inert on the wrong platform and live
# above. Only a value that differs per platform has to be split out.
#
# The path is relative to this file, and this must stay LAST because later
# values win. Gitignored — see .gitignore.
config-file = ?linux.conf
