# SSH client config, linked to ~/.ssh/config by initd (macOS and Linux; not
# the VM). Keys are never in here, and no private key is on disk at all: the
# exe.dev and GitHub keys live only in 1Password.

# Colima's VM (`ssh colima`). Colima prepends this line to ~/.ssh/config unless
# it is already there, which would write into this repo through the symlink;
# carrying it here (Colima expands the ~) leaves it nothing to add. Above every
# Host block, or it would only apply inside one. A missing file is skipped.
Include ~/.colima/ssh_config

# The remote dev box on exe.dev (VM name: videv). Every Ghostty window opens it
# on personal machines (shared/configs/ghostty/dev-box.conf); kitty stays local.
Host dev
  HostName videv.exe.xyz

# exe.dev itself (`ssh exe.dev help`) and every VM on it.
Host exe.dev *.exe.xyz dev
  # The PUBLIC half of the "exe.dev" 1Password item (see below).
  IdentityFile ~/.ssh/id_ed25519_exe.pub
  # Reuse one connection: a new window opens in ~0.06s instead of ~0.3-0.8s.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  # Send each keystroke at once. OpenSSH 9.5+ otherwise holds keys for a fixed
  # 20 ms clock (with chaff) to hide typing rhythm: measured 21-41 ms per key
  # here, against 19-20 ms with it off - the plain network round trip.
  ObscureKeystrokeTiming no
  # Notice a dead connection in ~10s instead of leaving a frozen window.
  ServerAliveInterval 5
  ServerAliveCountMax 2

# Pushes and pulls over SSH. The same key signs commits (see the signing
# include in shared/configs/git/gitconfig).
Host github.com
  # The PUBLIC half of the "GitHub" 1Password item (see below).
  IdentityFile ~/.ssh/id_ed25519_github.pub

# Both keys live only in 1Password - one item each, shared by every personal
# machine - and are served by its agent, so every use needs 1Password unlocked
# plus an approval. Linux's agent socket is at this path already; macOS
# bootstrap links it here from the app's Group Container. Scoped to these two
# hosts on purpose: the app's "Host *" suggestion would route every SSH login
# through it. The IdentityFile above is only the public half, written by
# shared/lib/ssh-keys.sh: with IdentitiesOnly it picks that one key out of the
# agent, so no other vault key is ever offered to either host.
Host exe.dev *.exe.xyz dev github.com
  IdentityAgent ~/.1password/agent.sock
  IdentitiesOnly yes
