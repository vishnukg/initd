# SSH client config, linked to ~/.ssh/config by initd (macOS and Linux; not
# the VM). Keys are never in here - each machine makes its own.

# The remote dev box on exe.dev (VM name: videv). kitty's ctrl+shift+d /
# super+shift+d opens it in its own window, outside the local tmux.
Host dev
  HostName videv.exe.xyz

# exe.dev itself (`ssh exe.dev help`) and every VM on it.
Host exe.dev *.exe.xyz dev
  # This machine's exe.dev key, separate from the GitHub one (id_ed25519).
  # New machine: ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_exe, then add the
  # .pub from an already-registered machine with `ssh exe.dev ssh-key add`.
  IdentityFile ~/.ssh/id_ed25519_exe
  IdentitiesOnly yes
  # Reuse one connection: a new window opens in ~0.06s instead of ~0.3-0.8s.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  # Notice a dead connection in ~30s instead of leaving a frozen window.
  ServerAliveInterval 15
  ServerAliveCountMax 2
