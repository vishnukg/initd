// Waybar — port of the polybar layout (workspaces left; cpu, memory, wlan,
// pulseaudio, backlight, power profile, battery, tray, clock right).
// No hardware patching needed: waybar auto-detects the default network
// interface, battery and backlight device.
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 14,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right": [
        "custom/docker", "custom/weather", "cpu", "memory",
        "pulseaudio", "backlight", "custom/powerprofile", "battery",
        "network", "tray", "clock"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by": "number"
    },

    "cpu": {
        "interval": 2,
        "format": "<span size='15pt'>󰍛</span> {usage}%"
    },

    "memory": {
        "interval": 3,
        "format": "<span size='15pt'>󰾆</span> {percentage}%"
    },

    "custom/docker": {
        // Running container count; docker group membership is set by bootstrap.
        "exec": "docker ps -q 2>/dev/null | wc -l",
        "interval": 15,
        "format": "<span size='22pt'>󰡨</span> {}",
        "on-click": "~/.config/docker-menu.sh",
        "tooltip": false
    },

    "network": {
        "interval": 5,
        "format-wifi": "<span size='15pt'>󰤨</span> {essid}",
        "format-ethernet": "<span size='15pt'>󰈀</span> {ipaddr}",
        "format-disconnected": "<span size='15pt'>󰤭</span> --",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "pulseaudio": {
        "format": "<span size='15pt'>{icon}</span> {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "backlight": {
        "format": "<span size='15pt'>{icon}</span> {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "custom/powerprofile": {
        "exec": "~/.config/power-profile-status.sh",
        "interval": 5,
        "format": "<span size='15pt'>{}</span>",
        "on-click": "~/.config/power-profile-cycle.sh"
    },

    "battery": {
        "interval": 5,
        "states": { "critical": 10 },
        // "Plugged" covers the firmware's "Not charging" hold state — the
        // case the old polybar battery-status.sh script existed for.
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁾", "󰂀", "󰁹"]
    },

    "tray": {
        "icon-size": 22,
        "spacing": 8
    },

    "custom/weather": {
        // wttr.in geolocates by IP; emoji condition + temperature.
        "exec": "curl -sf --max-time 10 'https://wttr.in/?format=%c%t'",
        "interval": 1800,
        // The popup script raises RTMIN+8 after its own fresh fetch, so the
        // bar re-fetches too and can't stay stale next to the popup.
        "signal": 8,
        "format": "{}",
        "on-click": "~/.config/weather-popup.sh",
        "tooltip": false
    },

    "clock": {
        "interval": 5,
        "format": "<span size='15pt'>󰃭</span> {:%a %d %b %H:%M}"
    }
}
