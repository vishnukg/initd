// Waybar — port of the polybar layout (workspaces left; cpu, memory, wlan,
// pulseaudio, backlight, battery, tray, clock right).
// No hardware patching needed: waybar auto-detects the default network
// interface, battery and backlight device.
{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 8,
    // Floating-islands look: gap between the bar and the screen edges.
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    // WORKAROUND: the built-in hyprland/workspaces buttons do not dispatch
    // clicks correctly in this Fedora/Hyprland session. Keep this explicit
    // implementation until a future Waybar update resolves the behavior.
    // Revert this whole block to:
    //   "modules-left": ["hyprland/workspaces"],
    //   "hyprland/workspaces": { "format": "{id}", "sort-by": "number" },
    // and remove scripts/workspace-button.sh, scripts/workspace-events.py,
    // their symlinks in link_session_scripts (setup.sh), the
    // `exec-once = python3 ~/.config/workspace-events.py` line in
    // hyprland.conf, and the #custom-workspace-* rules in style.css.
    // Until then: explicit custom buttons, each click invoking Hyprland's
    // dispatcher directly (bypassing Waybar's broken internal call).
    "modules-left": [
        "custom/workspace-1", "custom/workspace-2", "custom/workspace-3",
        "custom/workspace-4", "custom/workspace-5", "custom/workspace-6",
        "custom/workspace-7", "custom/workspace-8", "custom/workspace-9",
        "custom/workspace-10"
    ],
    "modules-right": [
        "custom/docker", "custom/weather", "cpu", "memory",
        "pulseaudio", "backlight", "battery",
        "tray", "clock"
    ],

    "custom/workspace-1": {
        "exec": "~/.config/workspace-button.sh 1", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 1})'"
    },
    "custom/workspace-2": {
        "exec": "~/.config/workspace-button.sh 2", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 2})'"
    },
    "custom/workspace-3": {
        "exec": "~/.config/workspace-button.sh 3", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 3})'"
    },
    "custom/workspace-4": {
        "exec": "~/.config/workspace-button.sh 4", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 4})'"
    },
    "custom/workspace-5": {
        "exec": "~/.config/workspace-button.sh 5", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 5})'"
    },
    "custom/workspace-6": {
        "exec": "~/.config/workspace-button.sh 6", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 6})'"
    },
    "custom/workspace-7": {
        "exec": "~/.config/workspace-button.sh 7", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 7})'"
    },
    "custom/workspace-8": {
        "exec": "~/.config/workspace-button.sh 8", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 8})'"
    },
    "custom/workspace-9": {
        "exec": "~/.config/workspace-button.sh 9", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 9})'"
    },
    "custom/workspace-10": {
        "exec": "~/.config/workspace-button.sh 10", "return-type": "json", "signal": 9,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 10})'"
    },

    "cpu": {
        "interval": 2,
        "format": "<span size='17pt'>󰍛</span> {usage}%",
        "tooltip-format": "CPU usage: {usage}%"
    },

    "memory": {
        "interval": 3,
        "format": "<span size='17pt'>󰾆</span> {percentage}%",
        "tooltip-format": "Memory used: {used:0.1f} GiB / {total:0.1f} GiB"
    },

    "custom/docker": {
        // Running container count; docker group membership is set by bootstrap.
        "exec": "docker ps -q 2>/dev/null | wc -l",
        "interval": 15,
        "format": "<span size='28pt'>󰡨</span> {}",
        "on-click": "~/.config/docker-menu.sh",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "<span size='17pt'>{icon}</span> {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "backlight": {
        "format": "<span size='17pt'>{icon}</span> {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "battery": {
        "interval": 5,
        "states": { "critical": 10 },
        // "Plugged" covers the firmware's "Not charging" hold state — the
        // case the old polybar battery-status.sh script existed for.
        "format": "<span size='14pt'>{icon}</span> {capacity}%",
        "format-charging": "<span size='14pt'>󰂄</span> {capacity}%",
        "format-plugged": "<span size='14pt'>󰚥</span> {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁾", "󰂀", "󰁹"]
    },

    "tray": {
        "icon-size": 24,
        "spacing": 7
    },

    "custom/weather": {
        // wttr.in geolocates by IP; emoji condition + temperature.
        "exec": "curl -sf --max-time 10 'https://wttr.in/?format=%c%t'",
        "interval": 1800,
        // The popup script raises RTMIN+8 after its own fresh fetch, so the
        // bar re-fetches too and can't stay stale next to the popup.
        "signal": 8,
        "format": "{}",
        "on-click": "~/.config/weather-popup.sh",
        "tooltip": false
    },

    "clock": {
        "interval": 5,
        "format": "{:%a, %d %b  ·  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<b><span color='#8fb7e8'>{}</span></b>",
                "days": "<span color='#aeb4c3'>{}</span>",
                "weeks": "<span color='#6f7688'>W{}</span>",
                "weekdays": "<span color='#c4b5fd'>{}</span>",
                "today": "<b><span color='#0b0d13' background='#8fb7e8'> {} </span></b>"
            }
        }
    }
}
