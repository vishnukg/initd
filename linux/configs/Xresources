! Session default only — display-dpi.sh overrides per autorandr profile
! (laptop 144, docked/external 108) via xrdb -merge and xsettingsd Xft/DPI.
Xft.dpi: 144
Xft.autohint: 0
Xft.lcdfilter: lcddefault
Xft.hintstyle: hintfull
Xft.hinting: 1
Xft.antialias: 1
Xft.rgba: rgb
Xcursor.theme: DMZ-White
! Session default — display-dpi.sh scales this with the profile DPI (48@144).
Xcursor.size: 48
