/* Floating Prompt — minimalist dark */
configuration {
    modi:               "drun,window,run";
    font:               "Berkeley Mono SemiBold 15";
    show-icons:         true;
    drun-display-format: "{icon} {name}";
    sidebar-mode:       false;
}

* {
    /* Override ALL rofi built-in color variables to kill the Solarized base */
    background:                  transparent;
    foreground:                  #ececf1;
    lightbg:                     #1d202b;
    lightfg:                     #9299aa;
    separatorcolor:              transparent;

    normal-background:           transparent;
    normal-foreground:           #ececf1;
    alternate-normal-background: transparent;
    alternate-normal-foreground: #ececf1;
    selected-normal-background:  #8fb7e8;
    selected-normal-foreground:  #0b0c12;

    urgent-background:           transparent;
    urgent-foreground:           #ff6b7a;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: #ff6b7a;
    selected-urgent-background:  #ff6b7a;
    selected-urgent-foreground:  #0b0c12;

    active-background:           transparent;
    active-foreground:           #9bcda7;
    alternate-active-background: transparent;
    alternate-active-foreground: #9bcda7;
    selected-active-background:  #9bcda7;
    selected-active-foreground:  #0b0c12;

    /* Custom vars */
    bar:              #151720f4;
    fg:               #ececf1;
    fg-dim:           #9299aa;
    sel-bg:           #8fb7e8;
    sel-fg:           #0b0c12;

    background-color: transparent;
    text-color:       #ececf1;
    border-color:     transparent;
}

window {
    background-color: transparent;
    border:           0px;
    width:            40%;
}

mainbox {
    background-color: transparent;
    spacing:          6px;
    padding:          0;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bar;
    border-radius:    10px;
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @sel-bg;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "search apps...";
    placeholder-color: @fg-dim;
}

listview {
    background-color: #0b0c12cc;
    border:           0;
    spacing:          2px;
    padding:          4px 0 0;
    scrollbar:        false;
    lines:            8;
}

element {
    background-color: transparent;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          10px;
    children:         [ element-icon, element-text ];
}

element-icon { size: 20px; background-color: transparent; }
element-text { text-color: inherit; background-color: transparent; }

element.normal.normal   { background-color: transparent; text-color: #ececf1; }
element.selected.normal { background-color: @sel-bg;     text-color: @sel-fg; }
element.normal.urgent   { background-color: transparent; text-color: #ff6b7a; }
element.selected.urgent { background-color: #ff6b7a;     text-color: @sel-fg; }
element.normal.active   { background-color: transparent; text-color: #9bcda7; }
element.selected.active { background-color: #9bcda7;     text-color: @sel-fg; }
