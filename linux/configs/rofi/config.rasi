/* Launcher: one centred frosted card, Spotlight / ChromeOS style.
 *
 * The colours below are the defaults; ~/.local/state/initd/rofi.rasi
 * (written by linux/scripts/theme.mjs from the wallpaper) overrides them.
 * The import is absolute on purpose: a relative one resolves against rofi's
 * working directory, not this file. rofi still opens if it is missing, but
 * shows a warning banner, so theme.mjs `ensure` writes the defaults at every
 * login and in setup.sh -- the file always exists.
 * Hyprland blurs behind it (the "rofi" layer rule in hyprland.lua).
 * Used by every rofi here: apps, windows, the exit prompt, the Docker menu
 * and the wallpaper picker. */
configuration {
    modi:                "drun,window,run";
    font:                "Inter Medium 14";
    show-icons:          true;
    icon-theme:          "Reversal-dark";
    drun-display-format: "{name}";
    /* Matching: fuzzy, so "fx" reaches Firefox, and the list is RANKED by
       match quality (fzf scoring) instead of staying alphabetical with the
       non-matches filtered out -- the best match is the first row as you
       type. drun matches on the app name, generic name and keywords only:
       the defaults also searched the Exec line and the categories, which put
       half the menu under "files". */
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    drun-match-fields:   "name,generic,keywords";
    display-drun:        "󰍉";
    display-window:      "󰖴";
    display-run:         "󰍉";
    display-dmenu:       "󰍉";
    sidebar-mode:        false;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    accent:     #8fb7e8;
    on-accent:  #0b0c10;
    surface:    #14161de0;
    field:      #ffffff14;
    text:       #e8eaf0;
    text-muted: #aeb4c3;
    text-dim:   #656a78;
    urgent:     #e0788a;

    background-color: transparent;
    text-color:       @text;
    border-color:     transparent;
}

@import "~/.local/state/initd/rofi.rasi"

window {
    location:         center;
    anchor:           center;
    width:            640px;
    border-radius:    26px;
    border:           1px;
    border-color:     #ffffff24;
    background-color: @surface;
    padding:          18px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @field;
    border-radius:    16px;
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

/* The magnifier (a Nerd Font glyph via display-drun & co). */
prompt {
    font:       "Symbols Nerd Font 16";
    text-color: @accent;
}

entry {
    text-color:        @text;
    placeholder:       "Search";
    placeholder-color: @text-dim;
    cursor:            text;
}

message {
    border-radius:    14px;
    padding:          10px 14px;
    background-color: @field;
}

textbox {
    text-color: @text-muted;
}

listview {
    lines:        7;
    columns:      1;
    spacing:      4px;
    fixed-height: false;
    scrollbar:    false;
    cycle:        true;
}

element {
    border-radius: 14px;
    padding:       10px 12px;
    spacing:       14px;
    children:      [ element-icon, element-text ];
}

element-icon {
    size:   32px;
    cursor: pointer;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    cursor:         pointer;
}

element normal.normal,
element alternate.normal { background-color: transparent; text-color: @text; }
element selected.normal  { background-color: @accent;     text-color: @on-accent; }
element normal.urgent,
element alternate.urgent { background-color: transparent; text-color: @urgent; }
element selected.urgent  { background-color: @urgent;     text-color: @on-accent; }
element normal.active,
element alternate.active { background-color: transparent; text-color: @accent; }
element selected.active  { background-color: @accent;     text-color: @on-accent; }
