[core]
	pager = delta

[user]
	name = Vishnu Ganesan
	email = v.ganesan@xero.com

[interactive]
	diffFilter = delta --color-only

[merge]
	tool = nvimdiff

[delta]
	side-by-side = false
	line-numbers = true
	navigate = true
	syntax-theme = Visual Studio Dark+
	zero-style = "#e6edf3"
	file-style = blue
	file-decoration-style = blue
	file-added-label = [added]
	file-copied-label = [copied]
	file-modified-label = [modified]
	file-removed-label = [removed]
	file-renamed-label = [renamed]
	hunk-header-style = file line-number syntax
	hunk-header-file-style = magenta
	hunk-header-line-number-style = magenta
	hunk-header-decoration-style = magenta
	minus-style = red
	minus-emph-style = red bold
	plus-style = green
	plus-emph-style = green bold
	keep-plus-minus-markers = true

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true
