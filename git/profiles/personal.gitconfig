[core]
	pager = delta

[user]
	name = Vishnu Ganesan
	email = vishnukg@gmail.com

[interactive]
	diffFilter = delta --color-only

[delta]
	side-by-side = false
	line-numbers = true
	navigate = true
	syntax-theme = Visual Studio Dark+
	zero-style = "#e6edf3"
	file-style = "#8aa889"
	file-decoration-style = "#3a3a3a"
	file-added-label = [added]
	file-copied-label = [copied]
	file-modified-label = [modified]
	file-removed-label = [removed]
	file-renamed-label = [renamed]
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#8aa889"
	hunk-header-line-number-style = "#6f8495"
	hunk-header-decoration-style = "#3a3a3a"
	minus-style = syntax "#5c1f1f"
	minus-emph-style = syntax "#8f2f2f"
	plus-style = syntax "#0f5132"
	plus-emph-style = syntax "#197a42"
	keep-plus-minus-markers = true

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true
