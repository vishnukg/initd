# Local Go build output.
bin/

# Claude Code local settings (machine-specific).
.claude/

# Machine-local git identity (email) — never commit this.
shared/configs/git/local.gitconfig

# Fish — files managed by fisher or fish itself, not by this repo.
shared/configs/fish/.config/fish/fish_variables
shared/configs/fish/.config/fish/local.fish
shared/configs/fish/.config/fish/conf.d/local.fish
shared/configs/fish/.config/fish/functions/
shared/configs/fish/.config/fish/completions/
shared/configs/fish/.config/fish/conf.d/*
!shared/configs/fish/.config/fish/conf.d/00-initd-env.fish

# Neovim — generated plugin directory.
shared/configs/nvim/.config/nvim/plugin/

# ruby-lsp drops this in whatever directory nvim is opened from.
.ruby-lsp/

# GTK — bookmarks are written at runtime by file picker dialogs.
linux/configs/gtk-3.0/bookmarks

# hyprmoncfg generates the active monitor rules from tracked profiles.
linux/configs/hypr/monitors.lua
